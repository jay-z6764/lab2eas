#include <stdio.h>
int f(int n, int i) { if (i == n) return 0;
if (n % i == 0)
    return i + f(n, i + 1);

return f(n, i + 1);
}
int main() { int n, m, i;
scanf("%d%d", &n, &m);

if (n <= 0 || m <= 0 || n > m)
{
    printf("Ошибка");
    return 0;
}

for (i = n; i <= m; i++)
    if (f(i, 1) == i)
        printf("%d ", i);

return 0;
}
